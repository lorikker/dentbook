# App connections (RLS-enforced role)
DATABASE_URL="postgresql://dentbook_app:app_pw@localhost:5433/dentbook"
# Superuser connection: migrations, seed, test setup
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dentbook"
# Test database
TEST_DATABASE_URL="postgresql://dentbook_app:app_pw@localhost:5433/dentbook_test"
TEST_DIRECT_DATABASE_URL="postgres://postgres:postgres@localhost:5433/dentbook_test"

AUTH_SECRET="change-me"
OTP_PEPPER="change-me"

APP_URL="http://localhost:3000"

# MongoDB connection (ContactMessage, ActivityLog, Testimonial). Not needed
# for tests — those spin up an in-memory MongoDB automatically.
MONGODB_URI="mongodb://localhost:27017/dentbook"

# --- SMS -------------------------------------------------------------------
# "console" logs the OTP to the dev-server output (free, no signup — the default).
# "vonage" sends real SMS and works on a free Vonage trial (custom message
# bodies allowed, 5 verified test numbers).
# "twilio" also works, but its current free trial blocks custom message bodies,
# so OTP codes will NOT arrive until the account is upgraded.
# After changing this, restart `npm run dev`.
SMS_PROVIDER="console"
# https://console.twilio.com — Account Info panel
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="change-me"
# An SMS-capable Twilio number in E.164. Kosovo (+383) must also be enabled
# under Messaging > Settings > Geo Permissions, or sends fail with error 21408.
TWILIO_FROM="+15551234567"

# https://dashboard.nexmo.com/settings — API key + secret
VONAGE_API_KEY="change-me"
VONAGE_API_SECRET="change-me"
# Sender ID: an alphanumeric name (max 11 chars) or a Vonage number in E.164
VONAGE_FROM="Dentbook"

# --- OAuth -----------------------------------------------------------------
# Callback URLs to register with each provider:
#   {APP_URL}/api/auth/callback/google
#   {APP_URL}/api/auth/callback/facebook
GOOGLE_CLIENT_ID="change-me"
GOOGLE_CLIENT_SECRET="change-me"
FACEBOOK_CLIENT_ID="change-me"
FACEBOOK_CLIENT_SECRET="change-me"

# --- Scheduled jobs ---
CRON_SECRET="change-me"
